@model CineramaWebApp.Models.ViewModels.MiCuentaViewModel
@{
    ViewData["Title"] = "Mi Cuenta - Cinerama";
}

<div class="container my-5">

    <div class="card bg-dark text-white border-danger shadow-lg mb-4">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="fw-bold mb-1">👤 @Model.Usuario</h3>
                <p class="text-white-50 mb-0">Bienvenido a tu cuenta Cinerama</p>
            </div>
            <div class="text-center">
                <div class="display-6 fw-bold text-danger">@Model.PuntosAcumulados</div>
                <div class="small text-white-50">Puntos Acumulados</div>
            </div>
        </div>
    </div>

    <h4 class="fw-bold text-white mb-3">🎟️ Historial de Compras</h4>

    @if (!Model.Compras.Any())
    {
        <div class="alert alert-dark border-secondary text-white-50">
            Aún no tienes compras registradas.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var compra in Model.Compras)
            {
                <div class="col-md-6">
                    <div class="card bg-dark text-white border-secondary shadow-sm h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-danger mb-0">@compra.Pelicula</h5>
                                <span class="badge bg-secondary">#@compra.IdVenta</span>
                            </div>
                            <p class="mb-1 small text-white-50">🎬 @compra.Cine</p>
                            <p class="mb-1 small text-white-50">🗓️ Función: @compra.Funcion.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-2 small text-white-50">🛒 Comprado el @compra.Fecha.ToString("dd/MM/yyyy HH:mm")</p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fs-5 fw-bold text-white">S/ @compra.Monto.ToString("0.00")</span>
                                <span class="small text-white-50">@(compra.CodigoQR ?? "Sin código")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-4">
        <a href="/Cartelera/Index" class="btn btn-outline-light">← Volver a la Cartelera</a>
    </div>

</div>