@{
    ViewData["Title"] = "Selección de Asientos - Cinerama";
    int idFuncion = ViewBag.IdFuncion ?? 1;
}

<div class="container my-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card bg-dark text-white p-4 border-secondary shadow-lg rounded-3">
                
                <div class="mb-3">
                    <a href="javascript:history.back()" class="btn-volver-atras">
                        ← Cambiar Horario
                    </a>
                </div>

                <h3 class="text-center text-danger fw-bold mb-4">SELECCIÓN DE ASIENTOS</h3>

                <div class="w-75 mx-auto bg-danger text-white text-center py-1 mb-5 rounded shadow-sm fw-bold small">
                    🎭 PANTALLA
                </div>

                <div class="d-flex justify-content-center gap-3 mb-4 small">
                    <span class="badge bg-secondary px-3 py-2">Disponible</span>
                    <span class="badge bg-success px-3 py-2">Tu Selección</span>
                    <span class="badge bg-dark border border-secondary text-white-50 px-3 py-2">Ocupado</span>
                </div>

                <div id="gridAsientosWrapper" style="overflow-x: auto; max-width: 100%; padding-bottom: 12px;">
                    <div id="gridAsientos" class="d-flex flex-column align-items-start gap-2 my-3">
                        <div class="spinner-border text-danger my-4 mx-auto" role="status">
                            <span class="visually-hidden">Cargando mapa de asientos...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-dark text-white border-secondary shadow-lg p-4 sticky-top rounded-3" style="top: 20px;">
                <h4 class="fw-bold border-bottom border-secondary pb-2 mb-3 text-danger">Resumen de Compra</h4>

                <div class="my-3">
                    <p class="mb-1 text-white-50">Función N°: <strong id="lblFuncion" class="text-white">@idFuncion</strong></p>
                    <p class="mb-1 text-white-50">Precio Entrada: <strong class="text-white">S/ 15.00</strong></p>
                </div>

                <hr class="border-secondary" />

                <div class="mb-3">
                    <label class="fw-bold text-white-50 mb-1">Asientos Seleccionados:</label>
                    <div id="lblAsientosSeleccionados" class="text-warning fw-bold fs-5">
                        <span class="text-white-50 fs-6">Ninguno</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center my-3 fs-4 fw-bold text-white">
                    <span>Total:</span>
                    <span class="text-danger">S/ <span id="lblTotal">0.00</span></span>
                </div>

                <button id="btnContinuar" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm" disabled>
                    Continuar ➔
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ID_FUNCION = @idFuncion;
        const PRECIO_UNITARIO = 15.00;
        let asientosSeleccionados = [];

        document.addEventListener("DOMContentLoaded", () => {
            fetch(`/Venta/MapaAsientos?idFuncion=${ID_FUNCION}`)
                .then(res => res.json())
                .then(asientos => {
                    renderizarMapa(asientos);
                })
                .catch(err => {
                    console.error("Error al obtener mapa:", err);
                    document.getElementById("gridAsientos").innerHTML =
                        `<div class="alert alert-danger w-100 text-center">Error al conectar con la base de datos.</div>`;
                });

            document.getElementById("btnContinuar").addEventListener("click", irAlPago);
        });

        function renderizarMapa(listaAsientos) {
            const grid = document.getElementById("gridAsientos");
            grid.innerHTML = "";

            if (!listaAsientos || listaAsientos.length === 0) {
                grid.innerHTML = `<div class="text-white-50 p-3">No se encontraron asientos para esta función.</div>`;
                return;
            }

            const filas = {};
            listaAsientos.forEach(a => {
                const letraFila = a.fila || 'A';
                if (!filas[letraFila]) filas[letraFila] = [];
                filas[letraFila].push(a);
            });

            Object.keys(filas).sort().forEach(letraFila => {
                const filaDiv = document.createElement("div");
                filaDiv.className = "d-flex align-items-center gap-2 flex-nowrap";
                filaDiv.style.flexShrink = "0";

                const tagFila = document.createElement("span");
                tagFila.className = "fw-bold text-danger me-2";
                tagFila.style.width = "20px";
                tagFila.style.flexShrink = "0";
                tagFila.textContent = letraFila;
                filaDiv.appendChild(tagFila);

                filas[letraFila].forEach(asiento => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.style.width = "38px";
                    btn.style.height = "38px";
                    btn.style.flexShrink = "0";
                    btn.textContent = asiento.numero;

                    if (asiento.ocupado === true) {
                        btn.className = "btn btn-dark border-secondary text-white-50 disabled p-0 opacity-50";
                        btn.disabled = true;
                    } else {
                        btn.className = "btn btn-outline-light p-0 fw-bold";
                        btn.addEventListener("click", () => toggleAsiento(btn, asiento));
                    }

                    filaDiv.appendChild(btn);
                });

                grid.appendChild(filaDiv);
            });
        }

        function toggleAsiento(btn, asiento) {
            const index = asientosSeleccionados.findIndex(a => a.idAsiento === asiento.idAsiento);
            const etiqueta = `${asiento.fila}-${asiento.numero}`;

            if (index > -1) {
                asientosSeleccionados.splice(index, 1);
                btn.className = "btn btn-outline-light p-0 fw-bold";
            } else {
                asientosSeleccionados.push({ idAsiento: asiento.idAsiento, etiqueta: etiqueta });
                btn.className = "btn btn-success p-0 fw-bold shadow";
            }

            actualizarResumen();
        }

        function actualizarResumen() {
            const total = asientosSeleccionados.length * PRECIO_UNITARIO;
            const lblSeleccionados = document.getElementById("lblAsientosSeleccionados");
            const btnContinuar = document.getElementById("btnContinuar");

            if (asientosSeleccionados.length === 0) {
                lblSeleccionados.innerHTML = `<span class="text-white-50 fs-6">Ninguno</span>`;
                btnContinuar.disabled = true;
            } else {
                lblSeleccionados.textContent = asientosSeleccionados.map(a => a.etiqueta).join(", ");
                btnContinuar.disabled = false;
            }

            document.getElementById("lblTotal").textContent = total.toFixed(2);
        }

        function irAlPago() {
            if (!asientosSeleccionados || asientosSeleccionados.length === 0) {
                alert("Por favor, selecciona al menos un asiento antes de continuar.");
                return;
            }

            const totalCalculado = asientosSeleccionados.length * PRECIO_UNITARIO;
            const listaIds = asientosSeleccionados.map(a => a.idAsiento);

            sessionStorage.setItem("idFuncion", ID_FUNCION.toString());
            sessionStorage.setItem("asientosIds", JSON.stringify(listaIds));
            sessionStorage.setItem("montoTotal", totalCalculado.toString());

            window.location.href = '/Venta/Identificacion';
        }
    </script>
}