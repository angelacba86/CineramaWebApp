@{
    ViewData["Title"] = "Identifícate - Cinerama";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card bg-dark text-white shadow-lg border-secondary">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h3 class="mb-0 fw-bold">IDENTIFÍCATE</h3>
                    <p class="small text-white-50 mb-0">Elige cómo deseas continuar con tu compra</p>
                </div>
                <div class="card-body p-4">

                    <ul class="nav nav-pills nav-justified mb-4" id="identificacionTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active text-white fw-bold bg-danger" id="login-tab" data-bs-toggle="pill" data-bs-target="#login" type="button" role="tab">
                                🔑 Iniciar Sesión
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-white fw-bold" id="registro-tab" data-bs-toggle="pill" data-bs-target="#registro" type="button" role="tab">
                                📝 Registrate
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-white fw-bold" id="invitado-tab" data-bs-toggle="pill" data-bs-target="#invitado" type="button" role="tab">
                                🎟️ Invitado
                            </button>
                        </li>
                    </ul>

                    <!-- Mensaje de error / éxito genérico -->
                    <div id="alertBox" class="alert d-none" role="alert"></div>

                    <div class="tab-content" id="identificacionTabContent">

                        <div class="tab-pane fade show active" id="login" role="tabpanel">
                            <form id="formLogin" onsubmit="procesarLogin(event)">
                                <div class="mb-3">
                                    <label class="form-label">Correo Electrónico</label>
                                    <input type="email" id="loginEmail" class="form-control bg-secondary text-white border-0" placeholder="correo@ejemplo.com" required>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Contraseña</label>
                                    <input type="password" id="loginPassword" class="form-control bg-secondary text-white border-0" placeholder="••••••••" required>
                                </div>
                                <button type="submit" id="btnLogin" class="btn btn-danger w-100 btn-lg fw-bold">
                                    INGRESAR Y CONTINUAR AL PAGO
                                </button>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="registro" role="tabpanel">
                            <form id="formRegistro" onsubmit="procesarRegistro(event)">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Nombres</label>
                                        <input type="text" id="regNombre" class="form-control bg-secondary text-white border-0" placeholder="Nombre" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Apellidos</label>
                                        <input type="text" id="regApellido" class="form-control bg-secondary text-white border-0" placeholder="Apellido" required>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Correo Electrónico</label>
                                    <input type="email" id="regEmail" class="form-control bg-secondary text-white border-0" placeholder="correo@ejemplo.com" required>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Teléfono (opcional)</label>
                                        <input type="tel" id="regTelefono" class="form-control bg-secondary text-white border-0" placeholder="999 999 999">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Fecha de Nacimiento</label>
                                        <input type="date" id="regFechaNacimiento" class="form-control bg-secondary text-white border-0" required>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Contraseña</label>
                                    <input type="password" id="regPassword" class="form-control bg-secondary text-white border-0" placeholder="Aqui tu contraseña, que nadie mas la vea" required minlength="6">
                                </div>
                                <button type="submit" id="btnRegistro" class="btn btn-danger w-100 btn-lg fw-bold">
                                    REGISTRARME Y CONTINUAR
                                </button>
                            </form>
                        </div>

                        <div class="tab-pane fade text-center py-3" id="invitado" role="tabpanel">
                            <div class="alert alert-dark border-secondary text-white-50 mb-4">
                                ℹ️ Comprarás como invitado sin acumular Puntos Cinerama. Puedes registrarte en cualquier otro momento.
                            </div>
                            <button type="button" class="btn btn-outline-light btn-lg w-100 fw-bold" onclick="continuarComoInvitado()">
                                SEGUIR COMO INVITADO ➔
                            </button>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function mostrarAlerta(mensaje, tipo = "danger") {
        const box = document.getElementById("alertBox");
        box.className = `alert alert-${tipo}`;
        box.textContent = mensaje;
        box.classList.remove("d-none");
    }

    function setCargando(btnId, cargando, textoNormal) {
        const btn = document.getElementById(btnId);
        btn.disabled = cargando;
        btn.textContent = cargando ? "Procesando..." : textoNormal;
    }

    // 1. Login real contra el backend
    async function procesarLogin(e) {
        e.preventDefault();

        const email = document.getElementById("loginEmail").value.trim();
        const password = document.getElementById("loginPassword").value;

        setCargando("btnLogin", true, "INGRESAR Y CONTINUAR AL PAGO");

        try {
            const res = await fetch("/Account/Login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ Email: email, Password: password })
            });

            const data = await res.json();

            if (!data.exito) {
                mostrarAlerta(data.mensaje || "Correo o contraseña incorrectos.");
                setCargando("btnLogin", false, "INGRESAR Y CONTINUAR AL PAGO");
                return;
            }

            sessionStorage.setItem("tipoUsuario", "Registrado");
            window.location.href = "/Venta/Pago";
        } catch (err) {
            console.error(err);
            mostrarAlerta("No se pudo conectar con el servidor. Intenta nuevamente.");
            setCargando("btnLogin", false, "INGRESAR Y CONTINUAR AL PAGO");
        }
    }

    // 2. Registro real contra el backend
    async function procesarRegistro(e) {
        e.preventDefault();

        const nombre = document.getElementById("regNombre").value.trim();
        const apellido = document.getElementById("regApellido").value.trim();
        const email = document.getElementById("regEmail").value.trim();
        const telefono = document.getElementById("regTelefono").value.trim();
        const fechaNacimiento = document.getElementById("regFechaNacimiento").value;
        const password = document.getElementById("regPassword").value;

        if (!fechaNacimiento) {
            mostrarAlerta("Por favor ingresa tu fecha de nacimiento.");
            return;
        }

        setCargando("btnRegistro", true, "REGISTRARME Y CONTINUAR");

        try {
            const res = await fetch("/Account/Registrar", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    Nombre: nombre,
                    Apellido: apellido,
                    Email: email,
                    Password: password,
                    Telefono: telefono || null,
                    FechaNacimiento: fechaNacimiento
                })
            });

            const data = await res.json();

            if (!data.exito) {
                mostrarAlerta(data.mensaje || "No se pudo completar el registro.");
                setCargando("btnRegistro", false, "REGISTRARME Y CONTINUAR");
                return;
            }

            mostrarAlerta("¡Registro exitoso! Ahora inicia sesión para continuar.", "success");

            setTimeout(() => {
                document.getElementById("login-tab").click();
                document.getElementById("loginEmail").value = email;
            }, 1200);

            setCargando("btnRegistro", false, "REGISTRARME Y CONTINUAR");
        } catch (err) {
            console.error(err);
            mostrarAlerta("No se pudo conectar con el servidor. Intenta nuevamente.");
            setCargando("btnRegistro", false, "REGISTRARME Y CONTINUAR");
        }
    }

    // 3. Continuar como invitado directo al pago
    function continuarComoInvitado() {
        sessionStorage.setItem("tipoUsuario", "Invitado");
        window.location.href = "/Venta/Pago";
    }
</script>