@model IEnumerable<CineramaWebApp.Models.DTOs.CarteleraDTO>

@{
    ViewData["Title"] = "Cartelera y Estrenos - Cinerama";
}

<div id="carouselBanners" class="carousel slide shadow-sm mb-5" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselBanners" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#carouselBanners" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#carouselBanners" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786498457/p6e2ul1hybig1.png" class="d-block w-100" alt="Estreno 1" style="height: 600px; object-fit: cover;">
        </div>
        <div class="carousel-item">
            <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786497316/sha256_d27306ebba09dafb716ef3b0e9b3d84df99cafb9c5a678b1ecd9a3ccf73de5e6.webp" class="d-block w-100" alt="Promoción Cinerama" style="height: 600px; object-fit: cover;">
           
        </div>
        <div class="carousel-item">
            <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786498085/interstellar_ver7_xlg.jpg" class="d-block w-100" alt="Puntos Cinerama" style="height: 600px; object-fit: cover;">
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanners" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselBanners" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<div class="container">

    <div class="d-flex align-items-center mb-4 border-bottom border-danger pb-2">
        <h2 class="fw-bold text-danger mb-0 me-2">EN CARTELERA</h2>
        <span class="badge bg-danger rounded-pill">Ahora en Cines</span>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var pelicula in Model)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <div class="movie-card">
                        <img src="@pelicula.PosterUrl" class="card-img-poster" alt="@pelicula.Titulo" onerror="this.src='https://placehold.co/300x450/1a1a1a/ffffff?text=Cinerama';">

                        <div class="movie-overlay">
                            <span class="badge bg-danger mb-2 align-self-start px-2 py-1 fs-6 shadow-sm">
                                @pelicula.Clasificacion
                            </span>

                            <h5 class="fw-bold text-white mb-1">@pelicula.Titulo</h5>

                            <p class="text-light opacity-75 small mb-1">
                                🎭 @pelicula.Genero | ⏱️ @pelicula.DuracionMinutos min
                            </p>

                            <p class="text-secondary small text-truncate-2 mb-3">
                                @pelicula.Sinopsis
                            </p>

                            <a asp-controller="Cartelera"
                               asp-action="Detalle"
                               asp-route-id="@pelicula.IdPelicula"
                               asp-route-idCine="@ViewBag.IdCineSeleccionado"
                               asp-route-ciudad="@ViewBag.CiudadSeleccionada"
                               class="btn btn-danger btn-sm w-100 fw-bold shadow-sm">
                                🎟️ Ver Funciones
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-4 rounded-3 shadow-lg border border-secondary" style="background-color: #121212; color: #ffffff;">
                    <div class="fs-1 text-danger mb-2">🎬</div>
                    <h5 class="fw-bold mb-1">Sin funciones en esta selección</h5>
                    <p class="text-secondary mb-0">No hay películas disponibles para la búsqueda seleccionada en este momento.</p>
                </div>
            </div>
        }
    </div>

    <div class="d-flex align-items-center mt-5 mb-4 border-bottom border-light pb-2">
        <h2 class="fw-bold text-white mb-0 me-2"> PRÓXIMAMENTE</h2>
        <span class="badge bg-secondary rounded-pill">Muy Pronto</span>
    </div>

    <div class="row">
        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="movie-card">
                <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786502589/avatar.jpg" class="card-img-poster" alt="Avatar 3">
                <div class="movie-overlay">
                    <span class="badge bg-secondary mb-2 align-self-start px-2 py-1 fs-6 shadow-sm">
                        APT
                    </span>
                    <h5 class="fw-bold text-white mb-1">Avatar: Fuego y Ceniza</h5>
                    <p class="text-light opacity-75 small mb-1">
                        🎭 Ciencia Ficción | ⏱️ 180 min
                    </p>
                    <p class="text-secondary small text-truncate-2 mb-3">
                        Explora nuevas regiones de Pandora y la tribu del pueblo de las cenizas.
                    </p>
                    <button class="btn btn-outline-light btn-sm w-100 fw-bold disabled opacity-75">
                        📅 Estreno: Diciembre 2026
                    </button>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="movie-card">
                <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786502589/doomsday.jpg" class="card-img-poster" alt="Avengers">
                <div class="movie-overlay">
                    <span class="badge bg-secondary mb-2 align-self-start px-2 py-1 fs-6 shadow-sm">
                        13+
                    </span>
                    <h5 class="fw-bold text-white mb-1">Avengers: Doomsday</h5>
                    <p class="text-light opacity-75 small mb-1">
                        🎭 Acción / Aventura | ⏱️ 165 min
                    </p>
                    <p class="text-secondary small text-truncate-2 mb-3">
                        Los héroes más poderosos del planeta enfrentan una amenaza multiversal sin precedentes.
                    </p>
                    <button class="btn btn-outline-light btn-sm w-100 fw-bold disabled opacity-75">
                        📅 Estreno: Mayo 2027
                    </button>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="movie-card">
                <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786502588/residentevil.jpg" class="card-img-poster" alt="Moana 2">
                <div class="movie-overlay">
                    <span class="badge bg-secondary mb-2 align-self-start px-2 py-1 fs-6 shadow-sm">
                        APT
                    </span>
                    <h5 class="fw-bold text-white mb-1"> Resident Evil: Noche Cero</h5>
                    <p class="text-light opacity-75 small mb-1">
                        🎭 Suspense / Ciencia Ficción | ⏱️ 90 min
                    </p>
                    <p class="text-secondary small text-truncate-2 mb-3">
                       Raccoon City cae en una noche de puro terror y asfixiante supervivencia zombi.
                    </p>
                    <button class="btn btn-outline-light btn-sm w-100 fw-bold disabled opacity-75">
                        📅 Próximo Mes
                    </button>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="movie-card">
                <img src="https://res.cloudinary.com/cyeypvzh/image/upload/v1786502588/sonic.jpg" class="card-img-poster" alt="Sonic 3">
                <div class="movie-overlay">
                    <span class="badge bg-secondary mb-2 align-self-start px-2 py-1 fs-6 shadow-sm">
                        APT
                    </span>
                    <h5 class="fw-bold text-white mb-1">Sonic 3: La Película</h5>
                    <p class="text-light opacity-75 small mb-1">
                        🎭 Aventura / Comedia | ⏱️ 110 min
                    </p>
                    <p class="text-secondary small text-truncate-2 mb-3">
                        Sonic, Tails y Knuckles se unen para enfrentarse a un nuevo y poderoso adversario, Shadow.
                    </p>
                    <button class="btn btn-outline-light btn-sm w-100 fw-bold disabled opacity-75">
                        📅 Muy Pronto
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>